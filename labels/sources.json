      "aws.persistence.lambda-backdoor-function": {
        "source_path": "v2/internal/attacktechniques/aws/persistence/lambda-backdoor-function/main.go",
        "attack_tactics": [
          "persistence"
        ],
        "description": "Establishes persistence by backdooring a lambda function to allow its invocation from an external AWS account.\n\nWarm-up: \n\n- Create a Lambda function.\n\nDetonation: \n\n- Modify the Lambda function resource-base policy to allow lambda:InvokeFunction from an external, fictitious AWS account.",
        "detonate_calls": [
          "lambda:AddPermission"
        ],
        "revert_calls": [
          "lambda:RemovePermission"
        ],
        "identifiers": [
          "stratus-red-team-backdoor-f"
        ],
        "stated_techniques": []
      },
      "aws.persistence.lambda-overwrite-code": {
        "source_path": "v2/internal/attacktechniques/aws/persistence/lambda-overwrite-code/main.go",
        "attack_tactics": [
          "persistence"
        ],
        "description": "Establishes persistence by overwriting a Lambda function's code. \nA further, more advanced, use-case could be updating the code to exfiltrate the data processed by the Lambda function at runtime.\n\nWarm-up: \n\n- Create a Lambda function.\n\nDetonation: \n\n- Update the Lambda function code.\n\nReferences:\n- https://research.splunk.com/cloud/aws_lambda_updatefunctioncode/\n- Expel's AWS security mindmap",
        "detonate_calls": [
          "lambda:UpdateFunctionCode"
        ],
        "revert_calls": [
          "lambda:UpdateFunctionCode"
        ],
        "identifiers": [
          "stratus-red-team-olc"
        ],
        "stated_techniques": []
      },
      "aws.persistence.rolesanywhere-create-trust-anchor": {
        "source_path": "v2/internal/attacktechniques/aws/persistence/rolesanywhere-create-trust-anchor/main.go",
        "attack_tactics": [
          "persistence",
          "privilege-escalation"
        ],
        "description": "Establishes persistence by creating an IAM Roles Anywhere trust anchor. \nThe IAM Roles Anywhere service allows workloads that do not run in AWS to assume roles by presenting a client-side \nX.509 certificate signed by a trusted certificate authority, called a \"trust anchor\".\n\nAssuming IAM Roles Anywhere is in use (i.e., that some of the IAM roles in the account have a \n[trust policy](https://docs.aws.amazon.com/rolesanywhere/latest/userguide/trust-model.html#trust-policy) trusting \nthe IAM Roles Anywhere service), an attacker creating a trust anchor can subsequently assume these roles.\n\nWarm-up:\n\n- Create an IAM role that can be used by IAM Roles Anywhere (see [docs](https://docs.aws.amazon.com/rolesanywhere/latest/userguide/getting-started.html#getting-started-step2))\n\nDetonation: \n\n- Create an IAM Roles Anywhere trust anchor\n- Create an IAM Roles Anywhere profile\n\nReferences:\n\n- https://docs.aws.amazon.com/rolesanywhere/latest/userguide/trust-model.html\n- https://docs.aws.amazon.com/rolesanywhere/latest/userguide/getting-started.html",
        "detonate_calls": [
          "rolesanywhere:CreateProfile",
          "rolesanywhere:CreateTrustAnchor"
        ],
        "revert_calls": [
          "rolesanywhere:DeleteProfile",
          "rolesanywhere:DeleteTrustAnchor",
          "rolesanywhere:ListProfiles",
          "rolesanywhere:ListTrustAnchors"
        ],
        "identifiers": [
          "stratus-red-team-trust-anchor"
        ],
        "stated_techniques": []
      }
    }
  },
